<!-- xml file for 2d kinematic solver -->
<mujoco>
    <compiler autolimits="true"/>

    <worldbody>
        <geom name="floor" type="plane" size="3 3 0.05" pos="0 0 -.75"/>
        <geom name="table" type="box" size="0.7 0.5 0.02" pos="0.2 0 -0.02" rgba="0.6 0.45 0.3 1"/>
        <light name="top_light" pos="0 0 2"/>

        <geom name="base" type="cylinder" fromto="0 0 0 0 0 0.10" size="0.04" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>

        <body name="link1" pos="0 0 0.10">
            <joint name="shoulder" type="hinge" axis="0 0 1" damping="1"/>
            <geom type="sphere" size="0.03" rgba="0.2 0.2 0.2 1"/>
            <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.02" rgba="0.3 0.5 0.8 1"/>

            <body name="link2" pos="0.35 0 0">
                <joint name="elbow" type="hinge" axis="0 0 1" damping="1"/>
                <geom type="sphere" size="0.03" rgba="0.2 0.2 0.2 1"/>
                <geom type="capsule" fromto="0 0 0 0.30 0 0" size="0.02" rgba="0.3 0.5 0.8 1"/>

                <body name="tool" pos="0.30 0 0" gravcomp="1">
                    <joint name="lift" type="slide" axis="0 0 1" range="-0.06 0" damping="5"/>
                    <geom type="sphere" size="0.025" rgba="0.2 0.2 0.2 1"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.08" size="0.008" rgba="0.6 0.6 0.6 1"/>
                    <geom name="suction_cup" type="cylinder" fromto="0 0 0 0 0 -0.02" size="0.015" rgba="0.1 0.1 0.1 1"/>
                    <site name="grip" pos="0 0 -0.02"/>
                </body>
            </body>
        </body>

        <body name="cube" pos="0.5 0.15 0.02">
            <freejoint/>
            <geom type="box" size="0.02 0.02 0.02" mass="0.05" rgba="0.9 0.2 0.2 1"/>
        </body>

        <geom name="target" type="box" size="0.04 0.04 0.001" pos="0.5 -0.2 0.001" contype="0" conaffinity="0" rgba="0.2 0.8 0.2 0.5"/>
    </worldbody>

    <actuator>
        <position name="shoulder" joint="shoulder" kp="50" ctrlrange="-3.14 3.14"/>
        <position name="elbow" joint="elbow" kp="50" ctrlrange="-3.14 3.14"/>
        <position name="lift" joint="lift" kp="1000" ctrlrange="-0.06 0"/>
        <adhesion name="suction" body="tool" ctrlrange="0 1" gain="10"/>
    </actuator>

    <keyframe>
        <key name="home" qpos="0 1.2 0" ctrl="0 1.2 0 0"/>
    </keyframe>
</mujoco>